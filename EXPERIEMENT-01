## 5. CODE-LEVEL REMEDIATION

### Comparison: Insecure vs. Hardened Implementation

```python
# ==============================================================================
# 1. INSECURE VULNERABLE CODE (assignment-01-sqli/vulnerable/vuln_queries.py)
# ==============================================================================
def vulnerable_login(username_input, password_input):
    pw_hash = hashlib.sha256(password_input.encode()).hexdigest()
    # DANGEROUS STRING INTERPOLATION:
    raw_query = f"SELECT * FROM users WHERE username = '{username_input}' AND password_hash = '{pw_hash}'"
    cursor.execute(raw_query)
    return cursor.fetchone()

# ==============================================================================
# 2. HARDENED REMEDIATED CODE (assignment-01-sqli/secure/secure_queries.py)
# ==============================================================================
def secure_login(username_input, password_input):
    # Defense Layer 1: Strict Regex Input Whitelisting
    if not re.match(r"^[a-zA-Z0-9_\-]{3,30}$", username_input):
        return {"status": "validation_error", "error": "Illegal username format"}

    pw_hash = hashlib.sha256(password_input.encode()).hexdigest()
    
    # Defense Layer 2: Parameterized Prepared Statement Placeholder
    parameterized_query = "SELECT id, username, email, role FROM users WHERE username = ? AND password_hash = ?"
    cursor.execute(parameterized_query, (username_input, pw_hash))
    return cursor.fetchone()
```

